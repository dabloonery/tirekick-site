{
  "name": "Tirekick workbench",
  "short_name": "Tirekick",
  "description": "What to list something for and where, the most to pay for a find, and your finds from bought to sold. Works offline; nothing leaves your phone.",
  "id": "/app/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1C2433",
  "theme_color": "#1C2433",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
